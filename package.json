{
    "name": "generator-agent",
    "displayName": "GeneratorAgent",
    "description": "A VS Code extension for conditional rule-based data generation",
    "version": "1.0.0",
    "publisher": "zohodesk",
    "engines": {
        "vscode": "^1.80.0"
    },
    "main": "./main.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "generator.start",
                "title": "Start Generator Agent"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ishwaryaramesh200-byte/Generator-Agent.git"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "agent",
        "generator",
        "automation"
    ],
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^2.20.0"
    }
}